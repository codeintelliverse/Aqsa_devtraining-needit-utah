        </filter_condition>
        <from/>
        <name>Create Occassion Followup</name>
        <order>100</order>
        <reply_email/>
        <required_roles/>
        <script><![CDATA[(function runAction(/*GlideRecord*/ current, /*GlideRecord*/ event,
    /*EmailWrapper*/ email, /*ScopedEmailLogger*/ logger, /*EmailClassifier*/ classifier) {

    // Add the sender with some static text to the Short description field,
    // then update the record in the database

    current.short_description = "Investigate reply to birthday email from " +
        email.sender;
    current.update();

})(current, event, email, logger, classifier);]]></script>
