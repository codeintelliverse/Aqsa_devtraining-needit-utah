        <action>record_action</action>
        <active>true</active>
        <assignment_operator/>
        <condition_script/>
        <description>Replies to requests in the Ready state are unexpected. This Inbound Action creates an Incident record to follow up with any replies received while the record is in the Ready state.</description>
        <event_name>email.read</event_name>
        <filter_condition table="sys_email">state=ready^EQ<item display_value="Ready" endquery="false" field="state" goto="false" newquery="false" operator="=" or="false" value="ready"/>
